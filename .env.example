# Copy to .env and load it into your shell before starting FlightTrace:
# set -a; source .env; set +a
FLIGHTTRACE_BIND=0.0.0.0:8088
FLIGHTTRACE_DATABASE=./data/debug-flighttrace.db
FLIGHTTRACE_MAVLINK_DIALECT=common
# Uncomment both lines for MAVLink ingestion:
# FLIGHTTRACE_MAVLINK=udp://127.0.0.1:14550
# FLIGHTTRACE_MISSION=examples/missions/simple_takeoff.yaml

# Uncomment to serve the prebuilt web UI from the same origin as the API.
# Run `cd web && npm run build` first.
# FLIGHTTRACE_WEB_DIR=./web/dist
# FLIGHTTRACE_OPEN=1

RUST_LOG=info,flighttrace=debug
RUST_BACKTRACE=1
